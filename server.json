{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/geoaeo",
  "description": "stdio MCP that audits sites and generates GEO/AEO artifacts.",
  "version": "0.3.1",
  "repository": {
    "url": "https://github.com/pooriaarab/usegeoaeo",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "geoaeo",
      "version": "0.3.1",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "positional", "valueHint": "subcommand", "value": "mcp" }
      ]
    }
  ]
}
