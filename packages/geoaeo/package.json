{
  "name": "geoaeo",
  "version": "0.8.5",
  "mcpName": "io.github.pooriaarab/geoaeo",
  "description": "SEO, GEO, and AEO site audits with llms.txt, JSON-LD, sitemap generators, framework scaffolding, and MCP tools.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "geoaeo": "dist/cli.js",
    "geoaeo-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai-txt": {
      "types": "./dist/ai-txt.d.ts",
      "import": "./dist/ai-txt.js",
      "require": "./dist/ai-txt.cjs"
    },
    "./mdmirror": {
      "types": "./dist/mdmirror.d.ts",
      "import": "./dist/mdmirror.js",
      "require": "./dist/mdmirror.cjs"
    },
    "./llms": {
      "types": "./dist/llms.d.ts",
      "import": "./dist/llms.js",
      "require": "./dist/llms.cjs"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "import": "./dist/robots.js",
      "require": "./dist/robots.cjs"
    },
    "./jsonld": {
      "types": "./dist/jsonld.d.ts",
      "import": "./dist/jsonld.js",
      "require": "./dist/jsonld.cjs"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js",
      "require": "./dist/audit.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./poppy": {
      "types": "./dist/poppy.d.ts",
      "import": "./dist/poppy.js",
      "require": "./dist/poppy.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/geoaeo.git"
  },
  "homepage": "https://usegeoaeo.com",
  "bugs": "https://github.com/pooriaarab/geoaeo/issues",
  "keywords": [
    "seo",
    "geo",
    "aeo",
    "llms-txt",
    "json-ld",
    "sitemap",
    "mcp",
    "Next.js",
    "Astro",
    "SvelteKit",
    "Nuxt",
    "Remix",
    "structured-data",
    "site-audit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
