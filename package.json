{
  "name": "geoaeo",
  "version": "0.2.1",
  "description": "GEO and AEO artifacts for answer engines and agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "geoaeo": "dist/cli.js",
    "geoaeo-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/geoaeo.git"
  },
  "homepage": "https://usegeoaeo.com",
  "bugs": "https://github.com/pooriaarab/geoaeo/issues",
  "keywords": [
    "seo",
    "geo",
    "aeo",
    "generative-engine-optimization",
    "answer-engine-optimization",
    "llms-txt",
    "structured-data",
    "json-ld",
    "webmcp",
    "mcp",
    "ai-search"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "jiti": "^2.5.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
