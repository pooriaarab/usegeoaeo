{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "jsx": "preserve",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "incremental": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".open-next/types/cloudflare-env.d.ts",
    ".wrangler/types/worker-configuration.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".open-next"
  ]
}
